<?xml version="1.0" encoding="UTF-8" ?>
<FlowTest xmlns="http://soap.sforce.com/2006/04/metadata">
    <description
  >Verifies that an Account created with an existing Rating keeps that Rating instead of being overwritten.</description>
    <flowApiName>Account_Set_Default_Rating</flowApiName>
    <label>Keep Existing Rating</label>
    <testType>WithAssertion</testType>
    <testPoints>
        <elementApiName>Start</elementApiName>
        <parameters>
            <leftValueReference>$Record</leftValueReference>
            <type>InputTriggeringRecordInitial</type>
            <value>
                <sobjectValue
        >{&quot;Name&quot;:&quot;Test Account&quot;,&quot;Rating&quot;:&quot;Hot&quot;}</sobjectValue>
            </value>
        </parameters>
    </testPoints>
    <testPoints>
        <elementApiName>Finish</elementApiName>
        <assertions>
            <conditions>
                <leftValueReference>$Record.Rating</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Hot</stringValue>
                </rightValue>
            </conditions>
            <errorMessage>Rating should remain "Hot" and must not be overwritten with the default value.</errorMessage>
        </assertions>
    </testPoints>
</FlowTest>
